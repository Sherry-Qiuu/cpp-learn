{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "C++: 编译当前文件",
            "type": "shell",
            "command": "g++",
            "args": [
                "-std=c++17",
                "-Wall",
                "-Wextra",
                "-Wpedantic",
                "-g",
                "-O0",
                "${file}",
                "-o",
                "${workspaceFolder}/build/${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "C++: 编译并运行当前文件",
            "dependsOn": ["C++: 编译当前文件"],
            "dependsOrder": "sequence",
            "type": "shell",
            "command": "./build/${fileBasenameNoExtension}.exe",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "test",
                "isDefault": true
            }
        },
        {
            "label": "C++: 严格模式编译（-Wconversion + -fanalyzer）",
            "type": "shell",
            "command": "g++",
            "args": [
                "-std=c++17",
                "-Wall",
                "-Wextra",
                "-Wpedantic",
                "-Wconversion",
                "-Wsign-conversion",
                "-Wshadow",
                "-fanalyzer",
                "-g",
                "-O0",
                "${file}",
                "-o",
                "${workspaceFolder}/build/${fileBasenameNoExtension}_strict.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "C++: 带 Sanitizer 运行当前文件（本机 MinGW 缺 libasan，见 README 常见问题）",
            "type": "shell",
            "command": "g++",
            "args": [
                "-std=c++17",
                "-Wall",
                "-Wextra",
                "-g",
                "-O0",
                "-fsanitize=address,undefined",
                "${file}",
                "-o",
                "${workspaceFolder}/build/${fileBasenameNoExtension}_san.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "C++: 看当前文件的汇编",
            "type": "shell",
            "command": "g++",
            "args": [
                "-std=c++17",
                "-O2",
                "-S",
                "${file}",
                "-o",
                "${workspaceFolder}/build/${fileBasenameNoExtension}.s"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            }
        }
    ]
}
